<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>covapsy_student_bringup</name>
  <version>0.1.0</version>
  <description>Lancement côté équipe : pilote en mode local (simulateur Python) ou distant (serveur enseignant)</description>
  <maintainer email="covapsy@example.com">covapsy</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>covapsy_pilote</exec_depend>
  <exec_depend>covapsy_autonomy</exec_depend>
  <exec_depend>covapsy_simple_sim</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
