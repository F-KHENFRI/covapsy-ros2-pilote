<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>covapsy_autonomy</name>
  <version>0.1.0</version>
  <description>Infrastructure voiture CoVAPSy : perception, état de course, sécurité</description>
  <maintainer email="covapsy@example.com">covapsy</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>ackermann_msgs</depend>
  <depend>std_srvs</depend>
  <depend>std_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>covapsy_interfaces</depend>
  <exec_depend>covapsy_simple_sim</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
